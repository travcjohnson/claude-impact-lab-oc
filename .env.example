# Copy to `.env` (git-ignored) and fill in locally. NEVER commit real values; this file holds none.
#
# The OCR-only backend needs NONE of these. With IHH_ANALYSIS_ADAPTER unset, no model is used,
# no key is needed, and /health, upload, OCR, search and page review all work.
#
# Load for a local run (the service does not read .env by itself):
#   set -a; . ./.env; set +a
#   python3 -m uvicorn backend.app:app --host 127.0.0.1 --port 8000

# Analysis adapter factory, 'backend.<module>:<factory>'. Only modules under backend/ are accepted.
# Leave blank until the BE-03 extraction module exists. The factory builds any model client lazily.
IHH_ANALYSIS_ADAPTER=

# Model ID. Deliberately NO default: pick one, then verify the key can see it before first use:
#   python3 -m pip install -r backend/requirements-analysis.txt
#   python3 -m backend.analysis check-model
IHH_ANALYSIS_MODEL=

# Server-side only. Never put this in the frontend, an issue, a PR or chat.
ANTHROPIC_API_KEY=

# Bounds (optional). Timeout per model call in seconds (1-600); total calls per packet (1-3).
IHH_ANALYSIS_TIMEOUT_SECONDS=120
IHH_ANALYSIS_MAX_ATTEMPTS=2

# Criteria location (optional). Default shown; relative paths resolve from the repository root.
# IHH_CRITERIA_DIR=challenges/1-referral-intake/criteria
